# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# Environment / secrets
.env

# OS
.DS_Store
Thumbs.db

# Runtime config (seeded from config.example.json on first run)
config.json

# Logs / data (generated at runtime)
temperature_log.csv
*.db
*.db-wal
*.db-shm

# Application logs
logs/

# Test artifacts (a .coverage db full of one machine's absolute paths
# was committed and churned on every run)
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# PyInstaller build artifacts
/build/
/dist/
*.spec.bak

# Generated firmware image for browser flashing (build with flash/build_merged_bin.sh)
flash/*.bin

# ---- KiCad ----
# Commit the sources (.kicad_pro / .kicad_sch / .kicad_pcb / project-local
# libraries / *-lib-table). Everything below is either regenerable output,
# per-user state, or an editor backup — see hardware/README.md.
*-backups/
*.kicad_prl
fp-info-cache
~*.*
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-cache.lib
*-rescue.lib
# Fabrication + export outputs (regenerate from the sources; large and churny)
gerbers/
*.gbr
*.gbrjob
*.drl
*.step
*.stp
*.wrl
*.net
