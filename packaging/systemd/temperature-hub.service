# systemd unit for the Temperature Hub (Linux).
#
# Install (onedir build — copy the whole folder):
#   sudo mkdir -p /opt/temperature-hub
#   sudo cp -r dist/temperature-hub/* /opt/temperature-hub/
#   sudo cp packaging/systemd/temperature-hub.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now temperature-hub
#
# Logs:  journalctl -u temperature-hub -f
# Data (config.json, temperature_log.db, logs/) is written to $DATA_DIR below,
# NOT to WorkingDirectory: a frozen build with no config.json beside the
# executable falls back to a per-user path under $HOME, which for a system
# service is not where anyone would look for it.

[Unit]
Description=Temperature Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/temperature-hub
ExecStart=/opt/temperature-hub/temperature-hub
Restart=on-failure
RestartSec=5
# systemd creates this under /var/lib and chowns it to User= on every start, so
# the data directory is correct and writable whether the service runs as root or
# as temphub. DATA_DIR pins it explicitly, which also short-circuits the
# expanduser("~") fallback in app.py — that raised PermissionError under a
# nologin account with no home, so the hardening line below used to make the
# service crash on startup.
StateDirectory=temperature-hub
Environment=DATA_DIR=/var/lib/temperature-hub
# Optional hardening — create the user first:
#   sudo useradd -r -d /var/lib/temperature-hub -s /usr/sbin/nologin temphub
# User=temphub
# Environment=PORT=8088

[Install]
WantedBy=multi-user.target
